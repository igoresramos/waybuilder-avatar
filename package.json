{
  "name": "waybuilder-avatar",
  "version": "0.3.0",
  "description": "Acervo e renderer do avatar do Waybuilder -- recorte curado do Liberated Pixel Cup",
  "type": "module",
  "types": "./dist/indice.d.ts",
  "exports": {
    ".": { "types": "./dist/indice.d.ts", "default": "./dist/indice.js" },
