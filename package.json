{
  "name": "waybuilder-avatar",
  "version": "0.1.0",
  "description": "Acervo e renderer do avatar do Waybuilder -- recorte curado do Liberated Pixel Cup",
  "type": "module",
  "types": "./dist/indice.d.ts",
  "exports": {
    ".": {
      "types": "./dist/indice.d.ts",
      "default": "./dist/indice.js"
    },
    "./catalogo.json": "./saida/catalogo.json",
    "./saida/*": "./saida/*"
  },
  "files": [
    "dist",
    "saida",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
